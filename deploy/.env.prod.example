# Copy to .env next to docker-compose.prod.yml and fill in.
# .env is gitignored. Never commit real values.

# Local image tag loaded over SSH (see deploy/README.md). Pin a commit SHA for
# reproducible deploys and rollbacks.
AUTH_IMAGE=authservicebyalien:latest

POSTGRES_DB=auth_db
POSTGRES_USER=auth_user
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required. Generate with: openssl rand -base64 32
# Back this up: losing it makes every stored signing key undecryptable.
JWT_KEK=replace-with-base64-32-bytes

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=auth@example.com
SMTP_PASS=replace-with-app-password
SMTP_FROM=auth@example.com
